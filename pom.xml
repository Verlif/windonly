<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>idea.verlif</groupId>
    <artifactId>windonly</artifactId>
    <version>1.3.2</version>
    <name>windonly</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.9.2</junit.version>

        <!-- JavaFX 版本。javafx-swing 需要与其它模块保持一致，避免运行期版本错配 -->
        <javafx.version>17.0.6</javafx.version>

        <!-- 打包配置 -->
        <app.name>windonly</app.name>
        <!--
            必须使用不继承 javafx.application.Application 的普通类作为入口：
            直接用 Application 子类做主类时，JDK 启动器会强制要求 JavaFX 位于模块路径上。
        -->
        <app.mainClass>idea.verlif.windonly.Launcher</app.mainClass>
        <!-- 免安装发行包内置运行时的模块集合 -->
        <app.runtime.modules>java.base,java.desktop,java.logging,java.prefs,java.xml,java.scripting,jdk.unsupported</app.runtime.modules>
        <app.dist.dir>${project.build.directory}/dist</app.dist.dir>
        <app.input.dir>${project.build.directory}/dist-input</app.input.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.Verlif</groupId>
            <artifactId>easy-dict</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.Verlif</groupId>
            <artifactId>easy-file</artifactId>
            <version>0.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.Verlif</groupId>
            <artifactId>socket-point</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>16</source>
                    <target>16</target>
                </configuration>
            </plugin>
            <!-- 开发期直接运行：mvnw javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>idea.verlif.windonly/idea.verlif.windonly.WindonlyApplication</mainClass>
                    <!-- 指向当前构建所用的 JDK，避免取到 PATH 上的旧版 java -->
                    <executable>${java.home}/bin/java</executable>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            一键打包免安装发行包（app-image + exe）。
            在 Windows 上自动启用，执行 mvnw clean package 后即可得到：

                target/dist/windonly/windonly.exe
                target/dist/windonly/lang/*.properties

            只想编译、不打包时用 -P '!windonly-exe' 关闭。

            流程：编译 -> 收集依赖 -> 打应用 jar -> jpackage 生成 exe -> 复制语言文件
        -->
        <profile>
            <id>windonly-exe</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <!-- 1. 清理上一次的产物：jpackage 不会覆盖已存在的目标目录 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>clean-package-output</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${app.dist.dir}</directory>
                                        </fileset>
                                        <fileset>
                                            <directory>${app.input.dir}</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        2. 收集运行时依赖。
                        org.openjfx 的构件在 Maven 上分为“空壳 jar”和平台分类器 jar，
                        copy-dependencies 会把空壳一起复制进来，因此这里排除 openjfx，
                        再由 copy 显式复制真正需要的平台 jar。
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${app.input.dir}</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.openjfx</excludeGroupIds>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy-javafx-dependencies</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${app.input.dir}</outputDirectory>
                                    <stripVersion>false</stripVersion>
                                    <artifactItems>
                                        <!-- 新增 JavaFX 模块时这里需要同步补充，否则发行包会缺少对应 jar -->
                                        <artifactItem>
                                            <groupId>org.openjfx</groupId>
                                            <artifactId>javafx-base</artifactId>
                                            <version>${javafx.version}</version>
                                            <classifier>win</classifier>
                                            <type>jar</type>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.openjfx</groupId>
                                            <artifactId>javafx-graphics</artifactId>
                                            <version>${javafx.version}</version>
                                            <classifier>win</classifier>
                                            <type>jar</type>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.openjfx</groupId>
                                            <artifactId>javafx-controls</artifactId>
                                            <version>${javafx.version}</version>
                                            <classifier>win</classifier>
                                            <type>jar</type>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.openjfx</groupId>
                                            <artifactId>javafx-fxml</artifactId>
                                            <version>${javafx.version}</version>
                                            <classifier>win</classifier>
                                            <type>jar</type>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>org.openjfx</groupId>
                                            <artifactId>javafx-swing</artifactId>
                                            <version>${javafx.version}</version>
                                            <classifier>win</classifier>
                                            <type>jar</type>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 3. 应用 jar 直接产出到打包输入目录 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <outputDirectory>${app.input.dir}</outputDirectory>
                            <finalName>${app.name}</finalName>
                            <archive>
                                <manifest>
                                    <mainClass>${app.mainClass}</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </plugin>

                    <!-- 4. 生成 exe 免安装包 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--dest</argument>
                                        <argument>${app.dist.dir}</argument>
                                        <argument>--input</argument>
                                        <argument>${app.input.dir}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${app.name}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${app.mainClass}</argument>
                                        <!-- jpackage 要求版本号只能是数字与点，形如 1.3.2-SNAPSHOT 会报错 -->
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Verlif</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/images/windonly.ico</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=utf-8</argument>
                                        <argument>--add-modules</argument>
                                        <argument>${app.runtime.modules}</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 5. 语言文件随包发布到 exe 同级目录，免去手工复制 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-lang-files</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${app.dist.dir}/${app.name}/lang</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/main/resources/lang</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
